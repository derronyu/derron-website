<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= current_page.data.title || "Derron Yu" %></title>
    <meta name="description" content="Derron Yu works across finance, investment strategy, research, and sustainable growth.">
    <link rel="icon" href="<%= site_path("/favicon.svg") %>" type="image/svg+xml">
    <%= stylesheet_link_tag "site" %>
    <%= javascript_include_tag "site", defer: true %>
  </head>
  <body class="<%= current_page.data.body_class %>">
    <a class="skip-link" href="#content">Skip to content</a>

    <header class="site-header">
      <div class="site-shell header-inner">
        <a class="site-brand" href="<%= site_path("/") %>" aria-label="Derron Yu home">
          <svg class="brand-mark" viewBox="0 0 55 40" aria-hidden="true">
            <path class="brand-mark__d" d="M2 4h13.6a18.4 16 0 0 1 0 32H2Z"></path>
            <path class="brand-mark__y" d="M31.3 4h21.3L42 17.4Z"></path>
          </svg>
          <span>Derron Yu</span>
        </a>

        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
          <span class="menu-toggle__label">Menu</span>
          <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
        </button>

        <nav id="site-navigation" class="site-navigation" aria-label="Main navigation">
          <button class="menu-close" type="button" aria-label="Close menu">Close</button>
          <ul>
            <li><a href="<%= site_path("/#expertise") %>">Expertise</a></li>
            <li><a href="<%= site_path("/#work") %>">Work</a></li>
            <li><a href="<%= site_path("/#research") %>">Research</a></li>
          </ul>
          <a class="menu-contact" href="mailto:derron-nis@hotmail.com">Contact</a>
        </nav>

        <div class="header-actions">
          <a class="header-linkedin" href="https://www.linkedin.com/in/derron-yu/">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="5" cy="5" r="2"></circle>
              <path d="M3.5 9h3v11h-3zM9 9h3v1.5c.9-1.2 2.2-1.8 3.7-1.8 3.5 0 4.3 2.3 4.3 5.3v6h-3v-5.3c0-1.6-.3-3.1-2.2-3.1-1.9 0-2.7 1.3-2.7 3V20H9Z"></path>
            </svg>
            <span>LinkedIn</span>
          </a>
          <a class="header-contact" href="mailto:derron-nis@hotmail.com">Contact</a>
        </div>
      </div>
    </header>

    <main id="content">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="site-shell footer-inner">
        <a class="site-brand site-brand--footer" href="<%= site_path("/") %>" aria-label="Derron Yu home">
          <svg class="brand-mark" viewBox="0 0 55 40" aria-hidden="true">
            <path class="brand-mark__d" d="M2 4h13.6a18.4 16 0 0 1 0 32H2Z"></path>
            <path class="brand-mark__y" d="M31.3 4h21.3L42 17.4Z"></path>
          </svg>
          <span>Derron Yu</span>
        </a>

        <div class="footer-contact">
          <a href="mailto:derron-nis@hotmail.com">derron-nis@hotmail.com</a>
          <a href="https://www.linkedin.com/in/derron-yu/">LinkedIn</a>
        </div>

        <div class="footer-meta">
          <span>Toronto, Canada</span>
          <span>&copy; <%= Time.now.year %> Derron Yu</span>
        </div>
      </div>
    </footer>
  </body>
</html>
